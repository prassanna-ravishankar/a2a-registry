# Database
DATABASE_URL=postgresql://user:password@localhost:5432/a2a_registry
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:5173","https://www.a2aregistry.org"]

# PostHog Analytics
POSTHOG_API_KEY=your-posthog-project-key
POSTHOG_HOST=https://us.posthog.com
POSTHOG_ENABLED=true

# Health Checks
HEALTH_CHECK_INTERVAL_SECONDS=300
HEALTH_CHECK_TIMEOUT_SECONDS=10
HEALTH_CHECK_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Jev request ceilings (see app/rate_limits.py)
JEV_DAILY_REQUESTS=1200
JEV_SUBMISSION_DAILY_REQUESTS=200
JEV_SUBMISSION_HOURLY_REQUESTS=60
JEV_CLIENT_DAILY_REQUESTS=60
