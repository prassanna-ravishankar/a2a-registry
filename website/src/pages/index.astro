---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RegistryTable from '@/components/RegistryTable.jsx';
import { loadRegistry, loadRegistryStats } from '@/lib/registryBuild';

const [registry, stats] = await Promise.all([loadRegistry(), loadRegistryStats()]);
const initialAgents = registry.agents;
const sweep = new Date(stats.generated_at);
const sweepLabel = sweep.toLocaleString('en-GB', { timeZone: 'UTC', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).replace(',', '') + ' UTC';
const title = 'A2A Registry — evidence for live A2A agents';
const description = `Inspect ${stats.total_agents} A2A agents by card conformance, reachability, uptime, and real message/send probes.`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'A2A Registry', url: 'https://a2aregistry.org/', description },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'A2A Registry', applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', url: 'https://a2aregistry.org/', description, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'A2A Registry', item: 'https://a2aregistry.org/' }] },
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} bodyClass="ledger-page">
  <!-- THESIS: Evidence is the product; refuse the dashboard-card directory. OWN-WORLD: warm paper, ink, hairlines, ledger rows, one evidence green. STORY: scan the register, inspect one canonical record, integrate with known caveats. FIRST VIEWPORT: document masthead, thesis, URL-driven search, and the first evidence rows. FORM: ship register, assigned direction 7, seed 3716de9b. -->
  <main class="ledger-shell">
    <header class="document-header">
      <div class="document-title"><a href="/">A2A REGISTRY</a><span>·</span><span>{stats.total_agents} agents</span><span>·</span><span>{stats.healthy_agents} reachable</span><span>·</span><time datetime={stats.generated_at} title={sweep.toISOString()}>sweep {sweepLabel}</time></div>
      <nav aria-label="Primary"><a href="/submit">Submit an agent</a><a href="/api/docs">API</a><a href="/mcp/">MCP</a><a href="https://github.com/prassanna-ravishankar/a2a-registry">Source</a></nav>
    </header>
    <section class="registry-intro"><h1>One agent.<br />One legible trust story.</h1><p>A public register of independently operated A2A agents. Evidence advances from card fetched to schema conformant, reachable, and task verified. It is observation—not endorsement.</p></section>
    <RegistryTable client:load initialAgents={initialAgents} initialTotal={registry.total} />
    <footer class="ledger-footer"><span>Evidence refreshes every 30 minutes.</span><span>Third-party endpoints may change after inspection.</span></footer>
  </main>
</BaseLayout>
