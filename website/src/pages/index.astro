---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ThemeToggle from '@/components/ThemeToggle.jsx';
import RegistryTable from '@/components/RegistryTable.jsx';
import { rowAgent, lastSweep } from '@/lib/registryView';
import { loadCategories, loadRegistry, loadRegistryStats } from '@/lib/registryBuild';

const [registry, stats, categories] = await Promise.all([loadRegistry(), loadRegistryStats(), loadCategories()]);
const initialAgents = registry.agents.map(rowAgent);
const sweepAt = lastSweep(registry.agents);
// Same ISO form the live refresh writes, so the label never changes format.
const sweepLabel = sweepAt ? `${sweepAt.slice(0, 16).replace('T', ' ')} UTC` : 'not recorded';
const title = 'A2A Registry · evidence for live A2A agents';
const description = `Inspect ${stats.total_agents} A2A agents by card conformance, reachability, uptime, and real message/send probes.`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'A2A Registry', url: 'https://a2aregistry.org/', description },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'A2A Registry', applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', url: 'https://a2aregistry.org/', description, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'A2A Registry', item: 'https://a2aregistry.org/' }] },
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} bodyClass="ledger-page">
  <main class="ledger-shell">
    <header class="document-header">
      <div class="document-title"><a href="/">A2A REGISTRY</a><span>·</span><span id="registry-count">{registry.agents.length} agents</span><span>·</span><span id="registry-healthy">{registry.agents.filter((agent) => agent.is_healthy === true).length} reachable</span><span>·</span><time id="registry-sweep" datetime={sweepAt || undefined} title={sweepAt || undefined}>sweep {sweepLabel}</time></div>
      <nav aria-label="Primary"><a href="/submit">Submit an agent</a><a href="/api/docs">API</a><a href="/mcp/">MCP</a><a href="https://github.com/prassanna-ravishankar/a2a-registry">GitHub</a><a href="https://github.com/prassanna-ravishankar/a2a-registry/issues">Feedback</a><ThemeToggle client:load /></nav>
    </header>
    <section class="registry-intro"><h1>Register of independently operated A2A agents. Evidence is observed, not endorsed.</h1></section>
    <RegistryTable client:load initialAgents={initialAgents} initialTotal={registry.total} initialCategories={categories} />
    <footer class="ledger-footer"><span>Third-party endpoints may change after inspection.</span></footer>
  </main>
</BaseLayout>
