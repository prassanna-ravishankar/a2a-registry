---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ThemeToggle from '@/components/ThemeToggle.jsx';
import SubmitPreview from '@/components/SubmitPreview.jsx';

const title = 'Submit an agent · A2A Registry';
const description = "Inspect an Agent Card's evidence before registering it with the A2A Registry.";
---
<BaseLayout title={title} description={description}>
  <main class="ledger-shell">
    <header class="document-header"><div class="document-title"><a href="/">A2A REGISTRY</a><span>·</span><span>SUBMIT</span></div><nav aria-label="Primary"><a href="/">Back to register</a><a href="/api/docs">API</a><ThemeToggle client:load /></nav></header>
    <section class="registry-intro"><h1>Paste the canonical Agent Card URL. The card is fetched read-only and its evidence is shown before anything is registered.</h1></section>
    <SubmitPreview client:load />
  </main>
</BaseLayout>
