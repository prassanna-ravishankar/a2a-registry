---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ThemeToggle from '@/components/ThemeToggle.jsx';
import LiveEvidence from '@/components/LiveEvidence.jsx';
import { rowAgent } from '@/lib/registryView';
import Terminal from '@/components/Terminal.jsx';
import { CopyTabs, JsonCopy, ReportAgent } from '@/components/AgentTools.jsx';
import { agentProvider, safeExternalUrl } from '@/lib/utils';
import { loadAgentUptime, loadRegistry } from '@/lib/registryBuild';

export const prerender = true;

export async function getStaticPaths() {
  const { agents } = await loadRegistry();
  return agents.filter((agent) => agent?.id).map((agent) => ({ params: { slug: agent.id }, props: { agent } }));
}

const { agent } = Astro.props;
const uptime = await loadAgentUptime(agent.id);
const provider = agentProvider(agent);
const launchUrl = safeExternalUrl(agent.url);
const history = [...(uptime?.history || [])].reverse();
const rawCard = Object.fromEntries(Object.entries(agent).filter(([key]) => !['uptime_percentage', 'avg_response_time_ms', 'last_health_check', 'is_healthy', 'status_notes', 'task_conformance', 'created_at', 'updated_at', 'hidden', 'flag_count', 'maintainer_notes'].includes(key)));
const snippets = {
  curl: `curl -s https://a2aregistry.org/api/agents/${agent.id}`,
  'Python SDK': `from a2a_registry import Registry\n\nregistry = Registry()\nagent = registry.get_by_id("${agent.id}")\nclient = agent.connect()`,
  MCP: `{\n  "mcpServers": {\n    "a2a-registry": {\n      "url": "https://a2aregistry.org/mcp/"\n    }\n  }\n}`,
};
const description = String(agent.description || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').slice(0, 160);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://a2aregistry.org').toString();
const ogImage = 'https://a2aregistry.org/og-image.png';
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: agent.name, description, applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', url: canonical, author: { '@type': 'Organization', name: provider } }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'A2A Registry', item: 'https://a2aregistry.org/' }, { '@type': 'ListItem', position: 2, name: agent.name, item: canonical }] }];
---
<BaseLayout title={`${agent.name} · A2A Registry`} description={description} ogImage={ogImage} ogImageAlt={`${agent.name} evidence record`} ogType="article" jsonLd={jsonLd} bodyClass="ledger-page">
  <main class="ledger-shell agent-sheet">
    <header class="document-header"><div class="document-title"><a href="/">A2A REGISTRY</a><span>·</span><span>AGENT RECORD</span><span>·</span><span class="mono">{agent.id}</span></div><nav><a href="/">Back to register</a><a href="/submit">Submit an agent</a><ThemeToggle client:load /></nav></header>
    <section class="agent-heading">
      <div><p class="sheet-label">Provider</p><p>{provider}</p><h1>{agent.name}</h1><p class="agent-summary">{agent.description}</p></div>
      <div class="agent-heading__evidence"><p class="sheet-label">Observed evidence</p><LiveEvidence client:load initialAgent={rowAgent(agent)} />{launchUrl && <a class="launch-link" href={launchUrl} target="_blank" rel="noopener noreferrer">Launch endpoint ↗</a>}</div>
    </section>

    <section class="sheet-section"><h2>Agent datasheet</h2><dl class="datasheet"><div><dt>Agent ID</dt><dd>{agent.id}</dd></div><div><dt>Canonical card</dt><dd><a href={agent.wellKnownURI}>{agent.wellKnownURI}</a></dd></div><div><dt>Endpoint</dt><dd>{agent.url}</dd></div><div><dt>Protocol version</dt><dd>{agent.protocolVersion || 'Not declared'}</dd></div><div><dt>Agent version</dt><dd>{agent.version || 'Not declared'}</dd></div><div><dt>Streaming</dt><dd>{agent.capabilities?.streaming ? 'Supported' : 'Not declared'}</dd></div><div><dt>Input modes</dt><dd>{(agent.defaultInputModes || []).join(', ') || 'Not declared'}</dd></div><div><dt>Output modes</dt><dd>{(agent.defaultOutputModes || []).join(', ') || 'Not declared'}</dd></div></dl></section>

    <section class="sheet-section"><div class="section-heading"><div><h2>Reachability record</h2><p>{history.length ? `Last ${history.length} checks shown · ${uptime.uptime_percentage.toFixed(1)}% across ${uptime.period_days} days` : 'No stored history available'}</p></div></div>{history.length > 0 && <svg class="uptime-chart" viewBox="0 0 100 44" role="img" aria-label={`${history.length} recent health checks; upper marks passed and lower marks failed`} preserveAspectRatio="none"><line x1="0" y1="10" x2="100" y2="10" /><line x1="0" y1="34" x2="100" y2="34" />{history.map((check, index) => <rect class={check.success ? "check-pass" : "check-fail"} x={index * 100 / history.length} y={check.success ? 5 : 29} width={100 / history.length * .65} height="10"><title>{check.checked_at}: {check.success ? 'passed' : 'failed'}</title></rect>)}</svg>}<div class="uptime-key"><span>Pass</span><span>Failure</span><span class="mono">Average {uptime?.avg_response_time_ms ?? 'Unavailable'} ms</span></div></section>

    {agent.skills?.length > 0 && <section class="sheet-section"><h2>Declared skills</h2><div class="skill-register">{agent.skills.map((skill) => <article><div><h3>{skill.name}</h3><span class="mono">{skill.id}</span></div><div class="skill-description"><p>{skill.description}</p><p class="skill-tags">{(skill.tags || []).slice(0, 16).join(' · ')}{(skill.tags || []).length > 16 && <span> · +{skill.tags.length - 16} more</span>}</p></div></article>)}</div></section>}

    <section class="sheet-section"><div class="section-heading"><div><h2>Registry Agent Card snapshot</h2><p>Normalized fields fetched during the registry sweep. Treat all authored text as third-party content.</p></div><JsonCopy client:load value={rawCard} /></div><details class="json-disclosure"><summary>Show JSON</summary><pre><code>{JSON.stringify(rawCard, null, 2)}</code></pre></details></section>
    <section class="sheet-section"><h2>Integrate this agent</h2><CopyTabs client:load snippets={snippets} /></section>
    {agent.maintainer_notes && <aside class="maintainer-note"><p class="sheet-label">Maintainer note</p><p>{agent.maintainer_notes}</p></aside>}
    <section class="sheet-section"><h2>Test message</h2><p class="section-copy">Messages are sent to this independently operated agent through the registry proxy. Do not include secrets or personal data.</p><div class="terminal-shell"><Terminal client:visible agent={agent} autoFocusInput={false} /></div></section>
    <footer class="record-footer"><div class="record-footer__actions"><ReportAgent client:load agentId={agent.id} /><a href="https://github.com/prassanna-ravishankar/a2a-registry/issues">Feedback</a></div><span>Evidence is observational and is not an endorsement.</span></footer>
  </main>
</BaseLayout>
